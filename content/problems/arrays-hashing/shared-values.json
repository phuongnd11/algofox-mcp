  "statement": {
    "markdown": "Given two integer arrays `a` and `b`, return a **sorted** array of the distinct values that appear in **both**.\n\nEach shared value should appear exactly once in the result, regardless of how many times it occurs in the inputs.",
    "constraints": [
      "0 <= a.length, b.length <= 10^4",
      "-10^9 <= values <= 10^9"
    ],
    "examples": [
      {
        "input": "a = [4, 9, 5], b = [9, 4, 9, 8, 4]",
        "output": "[4, 9]"
      },
      {
        "input": "a = [1, 2, 2, 1], b = [2, 2]",
        "output": "[2]"
      }
    ]
  },
  "signature": {
    "functionName": "shared_values",
    "params": [
      {
        "name": "a",
        "type": "int[]"
      },
      {
        "name": "b",
        "type": "int[]"
      }
    ],
    "returns": "int[]"
  },
